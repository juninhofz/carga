<?xml version="1.0" encoding="utf-8"?>
<!-- The workout panel, collapsed: the set (or the clock) in one line and the main button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/run_panel_bg" android:paddingStart="12dp" android:paddingEnd="8dp" android:paddingTop="6dp" android:paddingBottom="6dp">
    <ImageView android:layout_width="12dp" android:layout_height="18dp" android:src="@drawable/carga_mark" android:layout_marginEnd="8dp" />
    <Chronometer android:id="@+id/wk_clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:visibility="gone"
        android:textColor="#FFFF6B00" android:textSize="20sp" android:textStyle="bold" android:fontFamily="sans-serif-condensed" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/wk_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
            android:text="Agachamento" android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/wk_line" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
            android:text="Série 1 de 4 · 8 × 100 kg" android:textColor="#CCF6EEE8" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/wk_b1" android:layout_width="wrap_content" android:layout_height="36dp" android:paddingStart="12dp" android:paddingEnd="12dp"
        android:background="@drawable/run_btn_orange" android:gravity="center" android:orientation="horizontal">
        <ImageView android:id="@+id/wk_b1_icon" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_wk_check" />
        <TextView android:id="@+id/wk_b1_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp"
            android:text="Concluir" android:textColor="#FF120800" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
