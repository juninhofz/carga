{
  "appId": "app.carga.treino",
  "appName": "CARGA",
  "webDir": "dist",
  "backgroundColor": "#0d0d0d",
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "disable"
    },
    "SplashScreen": {
      "launchShowDuration": 8000,
      "launchAutoHide": true,
      "launchFadeOutDuration": 180,
      "backgroundColor": "#0d0d0d",
      "showSpinner": false
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "resetWhenUpdate": true,
      "statsUrl": "",
      "updateUrl": "",
      "channelUrl": "",
      "appReadyTimeout": 15000
    }
  }
}
